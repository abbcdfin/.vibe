#!/bin/sh
# Branching rule 1: main holds releases; push it only at a tagged release.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  if [ -z "$(git tag --points-at "$local_sha" 2>/dev/null)" ]; then
    echo "pre-push: main at $(echo "$local_sha" | cut -c1-7) is not a tagged release; push dev instead." >&2
    exit 1
  fi
done
